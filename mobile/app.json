{
  "expo": {
    "name": "Nancy",
    "slug": "ai-memory",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aimemory",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#D46A47"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aimemory.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AI Memory uses the microphone for voice input.",
        "NSLocationWhenInUseUsageDescription": "Nancy uses your location to give you accurate local weather and find nearby places like pharmacies and hospitals."
      }
    },
    "android": {
      "package": "com.aimemory.app",
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#D46A47"
      }
    },
    "plugins": [
      "expo-router",
      "expo-av",
      "expo-speech-recognition",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nancy uses your location to give you accurate local weather and find nearby places like pharmacies and hospitals."
        }
      ]
    ],
    "newArchEnabled": true,
    "icon": "./assets/icon.png"
  }
}