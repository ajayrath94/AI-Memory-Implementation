{
  "expo": {
    "name": "AI Memory",
    "slug": "ai-memory",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aimemory",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0f0f0f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aimemory.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AI Memory uses the microphone for voice input."
      }
    },
    "android": {
      "package": "com.aimemory.app",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-av",
      "expo-speech-recognition",
      "expo-secure-store"
    ],
    "newArchEnabled": false
  }
}
