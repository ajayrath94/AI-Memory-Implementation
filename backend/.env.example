# ── Nancy AI — Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values
# Never commit .env to git

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: supabase.com → project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key  # Use service_role, NOT anon key

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get from: aistudio.google.com → API Keys
# Enable: gemini-embedding-001 model (Pay-as-you-go)
GEMINI_API_KEY=AIza...

# ── Nancy API Security ────────────────────────────────────────────────────────
# Generate a random key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=your_random_api_key_here

# ── SendGrid (Email alerts) ───────────────────────────────────────────────────
# Get from: app.sendgrid.com → Settings → API Keys
# Verify sender: Settings → Sender Authentication → Single Sender Verification
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=your_verified_email@gmail.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# ── Optional ──────────────────────────────────────────────────────────────────
# VOYAGE_API_KEY=  # Alternative embeddings provider
# TWILIO_ACCOUNT_SID=  # For voice calls (future)
# TWILIO_AUTH_TOKEN=   # For voice calls (future)
# ELEVENLABS_API_KEY=  # For Nancy's voice (future)
